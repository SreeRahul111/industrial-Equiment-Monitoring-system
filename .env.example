# Industrial Equipment Monitoring System (IEMS) Environment Variables
PROJECT_NAME=Industrial Equipment Monitoring System (IEMS)
ENVIRONMENT=development
API_V1_STR=/api/v1

# Security
SECRET_KEY=change-this-in-production-use-strong-random-hex-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Database
# For local development, SQLite fallback is enabled when PostgreSQL is not configured:
DATABASE_URL=sqlite:///./backend/iems.db
# Target production PostgreSQL URL:
# DATABASE_URL=postgresql://iems_user:iems_secure_password@localhost:5432/iems_db

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]
